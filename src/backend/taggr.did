type HttpRequest = record { url : text; headers : vec record { text; text } };
type HttpResponse = record {
  body : blob;
  headers : vec record { text; text };
  upgrade : opt bool;
  status_code : nat16;
};
type Result = variant { Ok; Err : text };
type Result_1 = variant { Ok : nat64; Err : text };
type Result_2 = variant { Ok : record { text; nat64; nat64 }; Err : text };
service : () -> {
  add_admin : (text) -> (Result);
  add_post : (
      text,
      vec record { text; nat64; nat64 },
      opt nat64,
      opt text,
      opt blob,
    ) -> (Result_1);
  backup : () -> ();
  edit_post : (nat64, text, vec record { text; nat64; nat64 }, text, opt text) -> (
      Result,
    );
  http_request : (HttpRequest) -> (HttpResponse) query;
  http_request_update : (HttpRequest) -> (HttpResponse);
  prod_release : () -> (bool);
  set_media_bucket : (text) -> (Result);
  stable_mem_read : (nat64) -> (vec record { nat64; blob }) query;
  upload_media : (blob) -> (Result_2);
}
